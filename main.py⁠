BOT_STATE = {
    "status": "starting",
    "started_at": fmt_th(now_th()),
    "last_scan": None,
    "scan_count": 0,
    "last_price": 0.0,
    "killzone": "-",
    "active_trades": 0,
}


class ReusableHTTPServer(HTTPServer):
    allow_reuse_address = True


class HealthHandler(BaseHTTPRequestHandler):
    def _send(self, code: int, body: bytes, ctype: str) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0].rstrip("/") or "/"
        try:
            if path in ("/health", "/ping"):
                self._send(200, b"OK", "text/plain; charset=utf-8")
            elif path in ("/status", "/stats"):
                body = json.dumps(BOT_STATE, ensure_ascii=False, indent=2).encode("utf-8")
                self._send(200, body, "application/json; charset=utf-8")
            else:
                html = f"""<!doctype html><html><head><meta charset="utf-8"><title>SMC Gold Bot</title>
<style>body{{background:#0d1117;color:#e6edf3;font-family:sans-serif;padding:30px}}
.card{{background:#161b22;padding:20px;border-radius:10px;max-width:500px;margin:auto}}</style></head>
<body><div class="card"><h2>🥇 Spot Gold SMC Quant Bot</h2>
<p>Status: <b>{BOT_STATE['status'].upper()}</b></p>
<p>Last Price: <b>${BOT_STATE['last_price']:.2f}</b></p>
<p>Killzone: <b>{BOT_STATE['killzone']}</b></p>
<p>Scans: <b>{BOT_STATE['scan_count']}</b></p>
</div></body></html>"""
                self._send(200, html.encode("utf-8"), "text/html; charset=utf-8")
        except Exception:
            self._send(500, b"ERROR", "text/plain; charset=utf-8")

    def do_HEAD(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()

    def log_message(self, *args):
        return


def is_port_in_use(port: int) -> bool:
    """ตรวจสอบว่าพอร์ตนี้มีเซิร์ฟเวอร์เปิดทำงานอยู่แล้วหรือไม่"""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(("127.0.0.1", port)) == 0


def start_web_server() -> None:
    def _run():
        if is_port_in_use(CFG.PORT):
            log.info(f"[Web] พอร์ต {CFG.PORT} มีเซิร์ฟเวอร์เปิดรับ Ping อยู่แล้ว — ข้ามการเปิดซ้ำและเข้าสู่ลูปเทรด")
            return

        while True:
            try:
                srv = ReusableHTTPServer(("0.0.0.0", CFG.PORT), HealthHandler)
                log.info(f"[Web] Keep-Alive Server พร้อมทำงานที่พอร์ต {CFG.PORT}")
                srv.serve_forever()
            except Exception as e:
                if is_port_in_use(CFG.PORT):
                    log.info(f"[Web] พอร์ต {CFG.PORT} ถูกใช้งานแล้ว ปล่อยให้ระบบทำงานต่อ")
                    break
                log.warning(f"[Web] Server รอรีสตาร์ท: {e}")
                time.sleep(10)

    threading.Thread(target=_run, daemon=True, name="WebServer").start()


