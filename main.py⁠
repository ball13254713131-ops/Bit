                    json.dump(self.trades, f, ensure_ascii=False, indent=2)
            except Exception as e:
                log.error(f"[Trades] บันทึกไม่สำเร็จ: {e}")

    def can_open(self) -> tuple:
        if len(self.trades) >= CFG.MAX_CONCURRENT_TRADES:
            return False, f"มีไม้เปิดอยู่ครบ {CFG.MAX_CONCURRENT_TRADES} ไม้แล้ว"
        if self.last_signal_time:
            elapsed = (now_th() - self.last_signal_time).total_seconds() / 60
            if elapsed < CFG.SIGNAL_COOLDOWN_MIN:
                return False, f"อยู่ใน Cooldown (เหลือ {CFG.SIGNAL_COOLDOWN_MIN - elapsed:.0f} นาที)"
        return True, "พร้อมเปิดไม้ใหม่"

    def open_trade(self, ai: dict, ctx: dict, kz: dict, news_next: dict) -> dict:
        tid = f"XAU-{now_th().strftime('%y%m%d-%H%M%S')}"
        trade = {
            "id": tid,
            "direction": ai["decision"],
            "entry": ai["entry"],
            "stop_loss": ai["stop_loss"],
            "take_profit": ai["take_profit"],
            "risk_reward": ai["risk_reward"],
            "opened_at": fmt_th(now_th()),
            "opened_ts": now_th().timestamp(),
            "killzone": kz["zone"],
            "htf_bias": ctx["htf_bias"],
            "source": ai.get("source", "-"),
            "status": "OPEN",
        }
        self.trades.append(trade)
        self.last_signal_time = now_th()
        self._save()
        self.stats.record_signal(trade["direction"])
        self.notifier.send_signal(trade, ctx, ai, kz, news_next)
        log.info(f"[Trade] เปิดไม้ใหม่ {tid} {trade['direction']} @ {trade['entry']:.2f}")
        return trade

    def monitor(self, price: float) -> None:
        if not self.trades or price <= 0:
            return
        remaining = []
        for t in self.trades:
            closed, result = False, None
            if t["direction"] == "BUY":
                if price >= t["take_profit"]:
                    closed, result = True, "TP"
                elif price <= t["stop_loss"]:
                    closed, result = True, "SL"
            else:
                if price <= t["take_profit"]:
                    closed, result = True, "TP"
                elif price >= t["stop_loss"]:
                    closed, result = True, "SL"

            if closed:
                exit_price = t["take_profit"] if result == "TP" else t["stop_loss"]
                diff = (exit_price - t["entry"]) if t["direction"] == "BUY" else (t["entry"] - exit_price)
                points = diff / CFG.POINT_VALUE
                held = now_th().timestamp() - t.get("opened_ts", now_th().timestamp())
                t["duration"] = f"{int(held // 3600)} ชม. {int((held % 3600) // 60)} นาที"

                self.stats.record_result(t, result, points)
                self.notifier.send_close(t, result, points, self.stats)
                log.info(f"[Trade] ปิดไม้ {t['id']} {result} ({points:+.1f} pts)")
            else:
                remaining.append(t)

        if len(remaining) != len(self.trades):
            self.trades = remaining
            self._save()


