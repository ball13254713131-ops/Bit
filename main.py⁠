        if not self.enabled:
            log.warning("[AI] ไม่พบ API Key สำหรับ AI — ระบบจะใช้ Fallback Quant Engine อัตโนมัติ")

    @staticmethod
    def build_payload(ctx: dict, kz: dict, news_next: dict) -> dict:
        return {
            "symbol": "XAUUSD (Spot Gold via PAXG-USD)",
            "timestamp_bangkok": fmt_th(now_th()),
            "current_price": ctx["price"],
            "proposed_direction": ctx["direction"],
            "higher_timeframe_H1": {
                "bias": ctx["htf_bias"],
                "ema200": ctx["htf_ema200"],
                "close": ctx["htf_close"],
                "atr": ctx["htf_atr"],
                "swing_high_20": round(ctx["pd_array"]["swing_high"], 2),
                "swing_low_20": round(ctx["pd_array"]["swing_low"], 2),
                "equilibrium_50pct": round(ctx["pd_array"]["equilibrium"], 2),
            },
            "premium_discount_array": {
                "zone": ctx["pd_array"]["zone"],
                "position_in_range_pct": ctx["pd_array"]["position_pct"],
            },
            "liquidity_sweep": ctx["sweep"],
            "fair_value_gap_M15": ctx["fvg"],
            "momentum": {
                "rsi14_M15": ctx["ltf_rsi"],
                "atr14_M15": ctx["ltf_atr"],
            },
            "session": kz,
            "nearest_high_impact_news": news_next,
            "constraints": {"minimum_risk_reward": CFG.MIN_RR},
        }

    def _call_gemini(self, payload: dict) -> str:
        models = [CFG.GEMINI_MODEL, "gemini-2.5-flash", "gemini-1.5-flash"]
        last_e = None
        for m in models:
            url = f"https://generativelanguage.googleapis.com/v1beta/models/{m}:generateContent?key={CFG.GEMINI_API_KEY}"
            body = {
                "system_instruction": {"parts": [{"text": self.SYSTEM_PROMPT}]},
                "contents": [{
                    "role": "user",
                    "parts": [{"text": "Analyse setup and return JSON:\n" + json.dumps(payload, ensure_ascii=False)}]
                }],
                "generationConfig": {
                    "temperature": 0.15,
                    "maxOutputTokens": 1000,
                    "responseMimeType": "application/json",
                },
            }
            try:
                r = requests.post(url, json=body, timeout=CFG.AI_TIMEOUT)
                r.raise_for_status()
                data = r.json()
                return data["candidates"][0]["content"]["parts"][0]["text"]
            except Exception as e:
                last_e = e
                continue
        raise RuntimeError(f"Gemini API ล้มเหลวทุกโมเดล: {last_e}")

    def _call_claude(self, payload: dict) -> str:
        url = "https://api.anthropic.com/v1/messages"
        headers = {
            "x-api-key": CFG.CLAUDE_API_KEY,
            "anthropic-version": "2023-06-01",
            "content-type": "application/json",
        }
        body = {
            "model": CFG.CLAUDE_MODEL,
            "max_tokens": 1000,
            "temperature": 0.15,
            "system": self.SYSTEM_PROMPT,
            "messages": [{
                "role": "user",
                "content": "Analyse setup and return JSON:\n" + json.dumps(payload, ensure_ascii=False)
            }],
        }
        r = requests.post(url, headers=headers, json=body, timeout=CFG.AI_TIMEOUT)
        r.raise_for_status()
        data = r.json()
        return "".join(blk.get("text", "") for blk in data.get("content", []))

    @staticmethod
    def _extract_json(text: str) -> dict:
        t = text.strip()
        if "```" in t:
            parts = t.split("```")
            for p in parts:
                p = p.strip()
                if p.startswith("json"):
                    p = p[4:].strip()
                if p.startswith("{"):
                    t = p
                    break
        s, e = t.find("{"), t.rfind("}")
        if s == -1 or e == -1:
            raise ValueError("ไม่พบ JSON ในคำตอบ")
        return json.loads(t[s:e + 1])

    def validate(self, ctx: dict, kz: dict, news_next: dict) -> dict:
        payload = self.build_payload(ctx, kz, news_next)
        if not self.enabled:
            return FallbackEngine.decide(ctx, reason="ไม่ได้เปิดใช้งาน AI API")

        try:
            raw = self._call_gemini(payload) if self.provider == "gemini" else self._call_claude(payload)
            res = self._extract_json(raw)

            decision = str(res.get("decision", "WAIT")).upper()
            if decision not in ("BUY", "SELL"):
                return {"decision": "WAIT", "source": f"AI({self.provider})",
                        "reasoning_th": res.get("reasoning_th", "AI ประเมินว่ากราฟยังไม่ชัดเจน"),
                        "liquidity_narrative": res.get("liquidity_narrative", ""),
                        "confidence": int(safe_float(res.get("confidence", 0)))}

            entry = safe_float(res.get("entry"), ctx["price"])
            sl = safe_float(res.get("stop_loss"))
            tp = safe_float(res.get("take_profit"))

            valid = True
            if decision == "BUY" and not (sl < entry < tp):
                valid = False
            if decision == "SELL" and not (tp < entry < sl):
                valid = False

            if not valid or sl <= 0 or tp <= 0:
                log.warning("[AI] ค่า SL/TP ผิดตรรกะ → สลับไปใช้ Fallback")
                return FallbackEngine.decide(ctx, reason="AI ส่งค่า SL/TP ผิดตรรกะ")

            risk = abs(entry - sl)
            reward = abs(tp - entry)
            rr = reward / risk if risk > 0 else 0.0

            if rr < CFG.MIN_RR:
                return {"decision": "WAIT", "source": f"AI({self.provider})",
                        "reasoning_th": f"R:R 1:{rr:.2f} ต่ำกว่าเกณฑ์ขั้นต่ำ 1:{CFG.MIN_RR}",
                        "confidence": int(safe_float(res.get("confidence", 0)))}

            return {
                "decision": decision,
                "source": f"AI({self.provider})",
                "entry": round(entry, 2),
                "stop_loss": round(sl, 2),
                "take_profit": round(tp, 2),
                "risk_reward": round(rr, 2),
                "confidence": int(safe_float(res.get("confidence", 75))),
                "liquidity_narrative": res.get("liquidity_narrative", ""),
                "structure_reason": res.get("structure_reason", ""),
                "reasoning_th": res.get("reasoning_th", ""),
                "invalidation": res.get("invalidation", ""),
            }
        except Exception as e:
            log.error(f"[AI] เรียก API ล้มเหลว: {e} → ใช้ Fallback Quant")
            return FallbackEngine.decide(ctx, reason=f"AI ขัดข้อง ({type(e).__name__})")


