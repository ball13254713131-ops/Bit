class SMCEngine:
    @staticmethod
    def swing_points(df: pd.DataFrame, lookback: int) -> dict:
        seg = df.tail(lookback)
        sw_high = safe_float(seg["High"].max())
        sw_low = safe_float(seg["Low"].min())
        idx_high = seg["High"].idxmax()
        idx_low = seg["Low"].idxmin()
        return {
            "swing_high": sw_high,
            "swing_low": sw_low,
            "swing_high_time": idx_high,
            "swing_low_time": idx_low,
            "range": max(sw_high - sw_low, 1e-9),
            "equilibrium": (sw_high + sw_low) / 2.0,
        }

    @staticmethod
    def fractal_swings(df: pd.DataFrame, left: int = 2, right: int = 2, lookback: int = 40):
        seg = df.tail(lookback).reset_index(drop=False)
        highs, lows = [], []
        for i in range(left, len(seg) - right):
            h = seg["High"].iloc[i]
            l = seg["Low"].iloc[i]
            is_high = all(h > seg["High"].iloc[i - k] for k in range(1, left + 1)) and \
                      all(h > seg["High"].iloc[i + k] for k in range(1, right + 1))
            is_low = all(l < seg["Low"].iloc[i - k] for k in range(1, left + 1)) and \
                     all(l < seg["Low"].iloc[i + k] for k in range(1, right + 1))
            if is_high:
                highs.append({"price": safe_float(h), "idx": i})
            if is_low:
                lows.append({"price": safe_float(l), "idx": i})
        return list(reversed(highs)), list(reversed(lows))

    @classmethod
    def premium_discount(cls, htf: pd.DataFrame, price: float) -> dict:
        sw = cls.swing_points(htf, CFG.HTF_SWING_LOOKBACK)
        pos = (price - sw["swing_low"]) / sw["range"]
        if pos > 0.5 + CFG.EQ_BUFFER:
            zone = "PREMIUM"
        elif pos < 0.5 - CFG.EQ_BUFFER:
            zone = "DISCOUNT"
        else:
            zone = "EQUILIBRIUM"
        return {
            **sw,
            "position_pct": round(pos * 100, 2),
            "zone": zone,
            "allow_buy": zone == "DISCOUNT",
            "allow_sell": zone == "PREMIUM",
        }

    @classmethod
    def liquidity_sweep(cls, ltf: pd.DataFrame) -> dict:
        result = {"bullish_sweep": False, "bearish_sweep": False,
                  "swept_level": None, "sweep_bars_ago": None, "detail": "ไม่พบการกวาด Liquidity"}
        if len(ltf) < CFG.LTF_SWING_LOOKBACK + CFG.SWEEP_WINDOW + 5:
            return result

        hist = ltf.iloc[:-CFG.SWEEP_WINDOW]
        recent = ltf.tail(CFG.SWEEP_WINDOW)

        highs, lows = cls.fractal_swings(hist, left=2, right=2, lookback=CFG.LTF_SWING_LOOKBACK)
        ref_high = highs[0]["price"] if highs else safe_float(hist["High"].tail(CFG.LTF_SWING_LOOKBACK).max())
        ref_low = lows[0]["price"] if lows else safe_float(hist["Low"].tail(CFG.LTF_SWING_LOOKBACK).min())

        for i in range(len(recent)):
            row = recent.iloc[i]
            bars_ago = len(recent) - i - 1
            if row["Low"] < ref_low and row["Close"] > ref_low:
                result.update({
                    "bullish_sweep": True, "swept_level": round(ref_low, 2),
                    "sweep_bars_ago": bars_ago,
                    "detail": f"กวาด Sell-side Liquidity ใต้ {ref_low:.2f} แล้วปิดกลับเหนือระดับ ({bars_ago} แท่งก่อน)"
                })
            if row["High"] > ref_high and row["Close"] < ref_high:
                result.update({
                    "bearish_sweep": True, "swept_level": round(ref_high, 2),
                    "sweep_bars_ago": bars_ago,
                    "detail": f"กวาด Buy-side Liquidity เหนือ {ref_high:.2f} แล้วปิดกลับใต้ระดับ ({bars_ago} แท่งก่อน)"
                })

        result["ref_high"] = round(ref_high, 2)
        result["ref_low"] = round(ref_low, 2)
        return result

    @classmethod
    def detect_fvg(cls, ltf: pd.DataFrame, atr_val: float) -> dict:
        out = {"has_fvg": False, "type": None, "top": None, "bottom": None,
               "size": 0.0, "tested": False, "bars_ago": None, "detail": "ไม่พบ FVG ที่มีนัยยะ"}
        if len(ltf) < CFG.FVG_SCAN_BARS + 3:
            return out

        seg = ltf.tail(CFG.FVG_SCAN_BARS).reset_index(drop=True)
        price = safe_float(ltf["Close"].iloc[-1])
        min_size = max(atr_val * CFG.FVG_MIN_SIZE_ATR, 0.30)
        found = []

        for i in range(len(seg) - 3, -1, -1):
            c1, c2, c3 = seg.iloc[i], seg.iloc[i + 1], seg.iloc[i + 2]
            bars_ago = len(seg) - (i + 3)

            # Bullish FVG
            if c1["High"] < c3["Low"]:
                bottom, top = safe_float(c1["High"]), safe_float(c3["Low"])
                size = top - bottom
                if size >= min_size:
                    after = seg.iloc[i + 3:]
                    invalidated = (not after.empty) and (after["Low"].min() < bottom)
                    tested = bottom <= price <= top or (
                        (not after.empty) and after["Low"].min() <= top
                    )
                    if not invalidated:
                        found.append({"type": "BULLISH", "top": top, "bottom": bottom,
                                      "size": size, "tested": bool(tested), "bars_ago": bars_ago})

            # Bearish FVG
            if c1["Low"] > c3["High"]:
                top, bottom = safe_float(c1["Low"]), safe_float(c3["High"])
                size = top - bottom
                if size >= min_size:
                    after = seg.iloc[i + 3:]
                    invalidated = (not after.empty) and (after["High"].max() > top)
                    tested = bottom <= price <= top or (
                        (not after.empty) and after["High"].max() >= bottom
                    )
                    if not invalidated:
                        found.append({"type": "BEARISH", "top": top, "bottom": bottom,
                                      "size": size, "tested": bool(tested), "bars_ago": bars_ago})

            if found:
                break

        if found:
            f = found[0]
            out.update({
                "has_fvg": True, "type": f["type"],
                "top": round(f["top"], 2), "bottom": round(f["bottom"], 2),
                "size": round(f["size"], 2), "tested": f["tested"], "bars_ago": f["bars_ago"],
                "detail": f"{f['type']} FVG ช่วง {f['bottom']:.2f}-{f['top']:.2f} "
                          f"({f['size']:.2f} USD) {'[ทดสอบแล้ว]' if f['tested'] else '[ยังไม่ทดสอบ]'}"
            })
        return out

    @classmethod
    def evaluate(cls, htf: pd.DataFrame, ltf: pd.DataFrame) -> dict:
        price = safe_float(ltf["Close"].iloc[-1])

        htf = htf.copy()
        htf["EMA200"] = Indicators.ema(htf["Close"], CFG.EMA_PERIOD)
        htf["ATR"] = Indicators.atr(htf, CFG.ATR_PERIOD)
        ema200_h1 = safe_float(htf["EMA200"].iloc[-1], price)
        htf_close = safe_float(htf["Close"].iloc[-1], price)
        htf_bias = "BULLISH" if htf_close > ema200_h1 else "BEARISH"
        htf_atr = safe_float(htf["ATR"].iloc[-1], 1.0)

        ltf = ltf.copy()
        ltf["RSI"] = Indicators.rsi(ltf["Close"], CFG.RSI_PERIOD)
        ltf["ATR"] = Indicators.atr(ltf, CFG.ATR_PERIOD)
        rsi = safe_float(ltf["RSI"].iloc[-1], 50.0)
        atr = safe_float(ltf["ATR"].iloc[-1], 1.0)

        pd_arr = cls.premium_discount(htf, price)
        sweep = cls.liquidity_sweep(ltf)
        fvg = cls.detect_fvg(ltf, atr)

        ctx = {
            "price": round(price, 2),
            "htf_bias": htf_bias,
            "htf_ema200": round(ema200_h1, 2),
            "htf_close": round(htf_close, 2),
            "htf_atr": round(htf_atr, 2),
            "ltf_rsi": round(rsi, 2),
            "ltf_atr": round(atr, 2),
            "pd_array": pd_arr,
            "sweep": sweep,
            "fvg": fvg,
            "checks": {},
            "direction": "NONE",
            "reject_reasons": [],
        }

        buy_checks = {
            "discount_zone": pd_arr["allow_buy"],
            "liquidity_swept_low": sweep["bullish_sweep"],
            "bullish_fvg_tested": fvg["has_fvg"] and fvg["type"] == "BULLISH" and fvg["tested"],
            "htf_bias_ok": htf_bias == "BULLISH",
            "rsi_ok": CFG.RSI_BUY_RANGE[0] <= rsi <= CFG.RSI_BUY_RANGE[1],
        }

        sell_checks = {
            "premium_zone": pd_arr["allow_sell"],
            "liquidity_swept_high": sweep["bearish_sweep"],
            "bearish_fvg_tested": fvg["has_fvg"] and fvg["type"] == "BEARISH" and fvg["tested"],
            "htf_bias_ok": htf_bias == "BEARISH",
            "rsi_ok": CFG.RSI_SELL_RANGE[0] <= rsi <= CFG.RSI_SELL_RANGE[1],
        }

        buy_score = sum(1 for v in buy_checks.values() if v)
        sell_score = sum(1 for v in sell_checks.values() if v)

        if all(buy_checks.values()):
            ctx["direction"] = "BUY"
            ctx["checks"] = buy_checks
        elif all(sell_checks.values()):
            ctx["direction"] = "SELL"
            ctx["checks"] = sell_checks
        else:
            ctx["checks"] = {"buy": buy_checks, "sell": sell_checks}
            side = "BUY" if buy_score >= sell_score else "SELL"
            failed = [k for k, v in (buy_checks if side == "BUY" else sell_checks).items() if not v]
            ctx["reject_reasons"] = failed
            ctx["best_side"] = side
            ctx["best_score"] = f"{max(buy_score, sell_score)}/5"

        return ctx


