# 4. QUANTITATIVE INDICATORS & DATA NORMALIZATION
# ==================================================================================================
class CausalIndicators:
    @staticmethod
    def ema(series: pd.Series, period: int) -> pd.Series:
        return series.ewm(span=period, adjust=False).mean()

    @staticmethod
    def atr(df: pd.DataFrame, period: int = 14) -> pd.Series:
        h, l, c = df["High"], df["Low"], df["Close"]
        pc = c.shift(1)
        tr = pd.concat([(h - l), (h - pc).abs(), (l - pc).abs()], axis=1).max(axis=1)
        return tr.ewm(alpha=1.0 / period, adjust=False).mean()


def get_research_cutoff_utc() -> datetime:
    if BT_CFG.RESEARCH_CUTOFF_UTC:
        return datetime.fromisoformat(BT_CFG.RESEARCH_CUTOFF_UTC.replace("Z", "+00:00")).astimezone(timezone.utc)
    return datetime.now(timezone.utc)


def get_inclusive_bar_range(start_idx: int, max_span: int, total_len: int) -> range:
    end_bound = min(total_len, start_idx + max_span + 1)
    return range(start_idx, end_bound)


def drop_unclosed_tail(df: pd.DataFrame, cutoff_utc: datetime) -> pd.DataFrame:
    if df.empty:
        return df
    return df[df.index <= cutoff_utc].copy()


def normalize_to_close_time(index: pd.DatetimeIndex, interval_minutes: int) -> pd.DatetimeIndex:
    if interval_minutes > 0 and BT_CFG.SOURCE_INTRADAY_TIMESTAMP_IS_BAR_START:
        return index + timedelta(minutes=interval_minutes)
    return index


def get_ny_session_date(dt_ny: datetime) -> datetime.date:
    if dt_ny.hour > 17 or (dt_ny.hour == 17 and dt_ny.minute > 0):
        return dt_ny.date() + timedelta(days=1)
    return dt_ny.date()


def validate_and_clean_market_data(
    df: pd.DataFrame,
    name: str,
    interval_minutes: int,
    cutoff_utc: datetime,
    is_intraday: bool = True,
) -> pd.DataFrame:
    if df.empty:
        raise ValueError(f"CRITICAL: {name} DataFrame is empty.")

    clean_df = df.copy()
    clean_df.rename(columns={c: c.capitalize() for c in clean_df.columns}, inplace=True)
    required_cols = ["Open", "High", "Low", "Close"]
    for rc in required_cols:
        if rc not in clean_df.columns:
            raise ValueError(f"CRITICAL: {name} missing column {rc}")

    clean_df.dropna(subset=required_cols, inplace=True)

    if clean_df.index.tz is None:
        clean_df.index = clean_df.index.tz_localize(timezone.utc)
    else:
        clean_df.index = clean_df.index.tz_convert(timezone.utc)

    if is_intraday:
        clean_df.index = normalize_to_close_time(clean_df.index, interval_minutes)

    clean_df = drop_unclosed_tail(clean_df, cutoff_utc)
    clean_df = clean_df[~clean_df.index.duplicated(keep="first")].sort_index()
    return clean_df


