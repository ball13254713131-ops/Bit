        eql: List[CausalLevel],
    ) -> Tuple[bool, str, float, float, float, str]:
        risk_dist = abs(entry_price - sl_price)
        if risk_dist <= 0:
            return False, "INVALID_RISK_DISTANCE", 0.0, 0.0, 0.0, ""

        min_reward_dist = risk_dist * BT_CFG.MIN_RR

        if direction == "BUY":
            target_price = entry_price + min_reward_dist
            return True, "VALID_LIQUIDITY_TARGET", round(target_price, 2), BT_CFG.MIN_RR, BT_CFG.MIN_RR, "ATR_FLEX_TARGET"
        else:
            target_price = entry_price - min_reward_dist
            return True, "VALID_LIQUIDITY_TARGET", round(target_price, 2), BT_CFG.MIN_RR, BT_CFG.MIN_RR, "ATR_FLEX_TARGET"


class CausalSizingEngine:
    @staticmethod
    def calculate_lot(
        current_equity: float,
        risk_pct: float,
        executed_entry: float,
        sl_price: float,
    ) -> Tuple[bool, str, float, float, float]:
        allowed_risk_usd = current_equity * (risk_pct / 100.0)
        price_risk_dist = abs(executed_entry - sl_price)
        worst_case_risk_per_standard_lot = (
            (price_risk_dist + BT_CFG.ADVERSE_SLIPPAGE_USD) * BT_CFG.CONTRACT_SIZE
        ) + BT_CFG.COMMISSION_ROUND_TRIP

        if worst_case_risk_per_standard_lot <= 0:
            return False, "INVALID_RISK_PER_LOT", 0.0, 0.0, 0.0

        raw_lot = allowed_risk_usd / worst_case_risk_per_standard_lot
        steps = math.floor(raw_lot / BT_CFG.LOT_STEP)
        floored_lot = round(steps * BT_CFG.LOT_STEP, 4)
        final_lot = max(min(floored_lot, BT_CFG.MAX_LOT), BT_CFG.MIN_LOT)
        worst_case_modeled_risk_usd = round(final_lot * worst_case_risk_per_standard_lot, 2)

        return True, "LOT_APPROVED", final_lot, worst_case_modeled_risk_usd, worst_case_modeled_risk_usd


