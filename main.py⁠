def load_performance_stats():
    """โหลดสถิติจากไฟล์ JSON หากไม่มีให้สร้างใหม่"""
    if os.path.exists(CONFIG["STATS_FILE"]):
        try:
            with open(CONFIG["STATS_FILE"], "r", encoding="utf-8") as f:
                stats = json.load(f)
                logging.info(f"โหลดสถิติเดิมสำเร็จ: {stats}")
                return stats
        except Exception as e:
            logging.error(f"อ่านไฟล์สถิติไม่สำเร็จ: {e}")
    return {"wins": 0, "losses": 0, "total": 0}

def save_performance_stats(stats):
    """บันทึกสถิติลงไฟล์ JSON ทันทีเมื่อมีการปิดออเดอร์"""
    try:
        with open(CONFIG["STATS_FILE"], "w", encoding="utf-8") as f:
            json.dump(stats, f, indent=4)
        logging.info("บันทึกสถิติลงไฟล์สำเร็จ")
    except Exception as e:
        logging.error(f"บันทึกไฟล์สถิติไม่สำเร็จ: {e}")

performance_stats = load_performance_stats()

