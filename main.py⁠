def now_th() -> datetime:
    return datetime.now(CFG.TZ)


def fmt_th(dt: datetime) -> str:
    if dt is None:
        return "-"
    if dt.tzinfo is None:
        dt = CFG.TZ.localize(dt)
    return dt.astimezone(CFG.TZ).strftime("%d/%m/%Y %H:%M:%S")


def safe_float(x, default=0.0) -> float:
    try:
        v = float(x)
        if math.isnan(v) or math.isinf(v):
            return default
        return v
    except Exception:
        return default


