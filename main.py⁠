class NewsBlackoutEngine:
    def __init__(self):
        self.events = []
        self.last_fetch = 0.0
        self.lock = threading.Lock()

    def fetch(self, force: bool = False) -> None:
        if not force and (time.time() - self.last_fetch) < CFG.NEWS_REFRESH_SEC and self.events:
            return
        try:
            r = requests.get(
                CFG.FF_CALENDAR_URL, timeout=25,
                headers={"User-Agent": "Mozilla/5.0 (compatible; SMC-GoldBot/1.0)"}
            )
            r.raise_for_status()
            raw = r.json()
            parsed = []
            for ev in raw:
                country = str(ev.get("country", "")).upper()
                impact = str(ev.get("impact", "")).lower()
                if country != "USD" or impact != "high":
                    continue
                dt_str = ev.get("date")
                if not dt_str:
                    continue
                try:
                    dt = datetime.fromisoformat(dt_str.replace("Z", "+00:00"))
                    if dt.tzinfo is None:
                        dt = dt.replace(tzinfo=timezone.utc)
                except Exception:
                    continue
                parsed.append({
                    "title": ev.get("title", "Unknown"),
                    "time": dt.astimezone(CFG.TZ),
                    "forecast": ev.get("forecast", ""),
                    "previous": ev.get("previous", ""),
                })
            parsed.sort(key=lambda x: x["time"])
            with self.lock:
                self.events = parsed
                self.last_fetch = time.time()
            log.info(f"[News] โหลดข่าว USD High Impact สำเร็จ {len(parsed)} รายการ")
        except Exception as e:
            log.warning(f"[News] ดึงปฏิทินข่าวไม่สำเร็จ: {e}")

    def check_blackout(self, t: datetime = None) -> dict:
        t = t or now_th()
        self.fetch()
        with self.lock:
            evs = list(self.events)

        for ev in evs:
            start = ev["time"] - timedelta(minutes=CFG.NEWS_BLACKOUT_BEFORE_MIN)
            end = ev["time"] + timedelta(minutes=CFG.NEWS_BLACKOUT_AFTER_MIN)
            if start <= t <= end:
                return {
                    "blackout": True,
                    "event": ev["title"],
                    "event_time": ev["time"],
                    "reason": f"อยู่ในช่วง News Blackout: {ev['title']} "
                              f"เวลา {ev['time'].strftime('%d/%m %H:%M')} น. (±{CFG.NEWS_BLACKOUT_BEFORE_MIN} นาที)"
                }
        return {"blackout": False, "event": None, "event_time": None, "reason": "ไม่มีข่าวแรงในช่วงนี้"}

    def next_event(self, t: datetime = None) -> dict:
        t = t or now_th()
        self.fetch()
        with self.lock:
            for ev in self.events:
                if ev["time"] > t:
                    mins = int((ev["time"] - t).total_seconds() // 60)
                    return {"title": ev["title"], "time": ev["time"], "minutes_away": mins}
        return {"title": None, "time": None, "minutes_away": None}


