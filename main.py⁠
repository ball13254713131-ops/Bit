def is_killzone(cur_utc: datetime) -> Tuple[bool, str]:
    tz_london = pytz.timezone("Europe/London")
    tz_ny = pytz.timezone(BT_CFG.TRADING_DATE_TZ)
    london_m = cur_utc.astimezone(tz_london).hour * 60 + cur_utc.astimezone(tz_london).minute
    ny_m = cur_utc.astimezone(tz_ny).hour * 60 + cur_utc.astimezone(tz_ny).minute

    is_london = (8 * 60) <= london_m <= (11 * 60 + 30)
    is_ny = (8 * 60) <= ny_m <= (12 * 60)

    if is_london and is_ny:
        return True, "LONDON_NY_OVERLAP"
    elif is_london:
        return True, "LONDON_OPEN"
    elif is_ny:
        return True, "NY_OPEN"
    return False, "OFF_PEAK"


