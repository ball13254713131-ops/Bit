                f"**ระดับความมั่นใจ:** `{decision.get('confidence', 'HIGH')}`"
            ),
            "color": embed_color,
            "fields": [
                {
                    "name": "🎯 แผนราคา Spot Gold (Trade Parameters)",
                    "value": (
                        f"```yaml\n"
                        f"ENTRY : {decision['entry']:.2f}\n"
                        f"SL    : {decision['sl']:.2f} (-{sl_points:.1f} pts)\n"
                        f"TP    : {decision['tp']:.2f} (+{tp_points:.1f} pts)\n"
                        f"R:R   : 1:{rr_ratio:.1f}\n"
