class MarketDataFeed:
    def __init__(self):
        self._cache = {}
        self._cache_ts = {}

    def _download(self, interval: str, period: str, retries: int = 3) -> pd.DataFrame:
        last_err = None
        for attempt in range(1, retries + 1):
            try:
                tkr = yf.Ticker(CFG.SYMBOL)
                df = tkr.history(period=period, interval=interval, auto_adjust=False)
                if df is None or df.empty:
                    raise ValueError("ได้ DataFrame ว่างเปล่าจาก yfinance")

                df = df.rename(columns={c: c.capitalize() for c in df.columns})
                need = ["Open", "High", "Low", "Close"]
                for c in need:
                    if c not in df.columns:
                        raise ValueError(f"ไม่พบคอลัมน์ {c} ในข้อมูลที่ได้")

                if df.index.tz is None:
                    df.index = df.index.tz_localize("UTC")
                df.index = df.index.tz_convert(CFG.TZ)

                df = df[~df.index.duplicated(keep="last")]
                df = df.dropna(subset=need).sort_index()

                if len(df) < 30:
                    raise ValueError(f"ข้อมูลน้อยเกินไป ({len(df)} แท่ง)")

                return df
            except Exception as e:
                last_err = e
                log.warning(f"[DataFeed] ดึงข้อมูล {interval} ล้มเหลว (ครั้งที่ {attempt}/{retries}): {e}")
                time.sleep(2 * attempt)
        log.error(f"[DataFeed] ดึงข้อมูล {interval} ไม่สำเร็จ: {last_err}")
        return pd.DataFrame()

    def get_htf(self) -> pd.DataFrame:
        return self._download(CFG.HTF_INTERVAL, CFG.HTF_PERIOD)

    def get_ltf(self) -> pd.DataFrame:
        return self._download(CFG.LTF_INTERVAL, CFG.LTF_PERIOD)

    def get_live_price(self) -> float:
        key = "live"
        if key in self._cache and (time.time() - self._cache_ts.get(key, 0)) < 20:
            return self._cache[key]
        try:
            tkr = yf.Ticker(CFG.SYMBOL)
            fi = getattr(tkr, "fast_info", None)
            price = None
            if fi:
                price = safe_float(fi.get("last_price") if isinstance(fi, dict) else getattr(fi, "last_price", 0.0))
            if not price:
                d = tkr.history(period="1d", interval="1m")
                if d is not None and not d.empty:
                    price = safe_float(d["Close"].iloc[-1], 0.0)
            if price:
                self._cache[key] = price
                self._cache_ts[key] = time.time()
                return price
        except Exception as e:
            log.warning(f"[DataFeed] ดึงราคา live ไม่สำเร็จ: {e}")
        return self._cache.get(key, 0.0)


