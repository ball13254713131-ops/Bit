class CausalLiquidityEngine:
    @staticmethod
    def get_confirmed_fractals(
        df_history: pd.DataFrame,
        eval_time: datetime,
        window: int = BT_CFG.FRACTAL_CONFIRM_BARS,
    ) -> Tuple[List[CausalLevel], List[CausalLevel]]:
        highs, lows = [], []
        n = len(df_history)
        if n < (window * 2 + 1):
            return highs, lows

        for i in range(window, n - window):
            h_curr = float(df_history["High"].iloc[i])
            l_curr = float(df_history["Low"].iloc[i])
            formation_time = df_history.index[i]
            confirmed_time = df_history.index[i + window]

            if confirmed_time > eval_time:
                continue

            is_high, is_low = True, True
            for k in range(1, window + 1):
                if df_history["High"].iloc[i - k] >= h_curr or df_history["High"].iloc[i + k] >= h_curr:
                    is_high = False
                if df_history["Low"].iloc[i - k] <= l_curr or df_history["Low"].iloc[i + k] <= l_curr:
                    is_low = False

            if is_high:
                highs.append(CausalLevel("SWING_HIGH", h_curr, formation_time, confirmed_time))
            if is_low:
                lows.append(CausalLevel("SWING_LOW", l_curr, formation_time, confirmed_time))

        return highs, lows

    @staticmethod
    def get_causal_equal_levels(
        df_history: pd.DataFrame,
        eval_time: datetime,
        tolerance: float = BT_CFG.EQUAL_LEVEL_TOLERANCE,
    ) -> Tuple[List[CausalLevel], List[CausalLevel]]:
        h_vals = df_history["High"].values
        l_vals = df_history["Low"].values
        n = len(h_vals)
        eqh, eql = [], []
        if n < 10:
            return eqh, eql

        for i in range(max(0, n - 50), n - 4):
            t1 = df_history.index[i]
            for j in range(i + 3, min(i + 20, n)):
                t2 = df_history.index[j]
                if t2 > eval_time:
                    continue

                if abs(h_vals[i] - h_vals[j]) / h_vals[i] <= tolerance:
                    avg_p = round(float(h_vals[i] + h_vals[j]) / 2.0, 2)
                    eqh.append(CausalLevel("EQH", avg_p, t1, t2))

                if abs(l_vals[i] - l_vals[j]) / l_vals[i] <= tolerance:
                    avg_p = round(float(l_vals[i] + l_vals[j]) / 2.0, 2)
                    eql.append(CausalLevel("EQL", avg_p, t1, t2))

        return eqh, eql

    @staticmethod
    def extract_closed_session_and_daily_levels(
        df_ltf_history: pd.DataFrame,
        current_time: datetime,
    ) -> List[CausalLevel]:
        levels: List[CausalLevel] = []
        if df_ltf_history.empty or len(df_ltf_history) < 45:
            return levels

        ny_tz = pytz.timezone(BT_CFG.TRADING_DATE_TZ)
        sub_ny = df_ltf_history.copy()
        sub_ny["ny_time"] = sub_ny.index.tz_convert(ny_tz)
        sub_ny["session_date"] = sub_ny["ny_time"].apply(get_ny_session_date)

        cur_ny_time = current_time.astimezone(ny_tz)
        cur_session_date = get_ny_session_date(cur_ny_time)

        completed_sessions = sub_ny[sub_ny["session_date"] < cur_session_date]
        if not completed_sessions.empty:
            last_sess_date = completed_sessions["session_date"].max()
            last_sess_bars = completed_sessions[completed_sessions["session_date"] == last_sess_date].sort_index()
            if not last_sess_bars.empty:
                pdh = round(float(last_sess_bars["High"].max()), 2)
                pdl = round(float(last_sess_bars["Low"].min()), 2)
                conf_time = last_sess_bars.index[-1]
                if conf_time <= current_time:
                    levels.append(CausalLevel("PDH", pdh, last_sess_bars.index[0], conf_time))
                    levels.append(CausalLevel("PDL", pdl, last_sess_bars.index[0], conf_time))

        return levels

    @staticmethod
    def get_last_closed_htf_bar(df_htf: pd.DataFrame, signal_time: datetime) -> Optional[pd.Series]:
        past_htf = df_htf[df_htf.index <= signal_time]
        if past_htf.empty:
            return None
        return past_htf.iloc[-1]


class CausalSequenceEngine:
    @classmethod
    def evaluate(
        cls,
        df_closed: pd.DataFrame,
        h1_bias: str,
        levels: List[CausalLevel],
        fractal_highs: List[CausalLevel],
        fractal_lows: List[CausalLevel],
        eqh: List[CausalLevel],
        eql: List[CausalLevel],
        params: Dict[str, float],
    ) -> Tuple[bool, str, Dict[str, Any]]:
        n = len(df_closed)
        if n < 45:
            return False, "INSUFFICIENT_HISTORY", {}

        cur_bar = df_closed.iloc[-1]
        t_now_idx = n - 1
        cur_atr = float(cur_bar["ATR"])
        if cur_atr <= 0:
            return False, "INVALID_ATR", {}

        sl_atr_buf = params["sl_atr_buffer"]
        min_disp_ratio = params["min_displacement_ratio"]
        min_wick_ratio = params["min_rejection_wick_ratio"]

        if h1_bias == "BULLISH":
            candidate_lows: List[CausalLevel] = [lv for lv in levels if lv.level_type == "PDL"]
            candidate_lows += eql
            candidate_lows += fractal_lows

            sweep: Optional[SweepEvent] = None
            for s_idx in range(t_now_idx - 5, max(0, t_now_idx - 18), -1):
                bar_s = df_closed.iloc[s_idx]
                bar_s_time = df_closed.index[s_idx]
                for target_level in candidate_lows:
                    if target_level.confirmed_time < bar_s_time and bar_s["Low"] < target_level.price and bar_s["Close"] > target_level.price:
                        sweep = SweepEvent(
                            timestamp=bar_s_time,
                            bar_index=s_idx,
                            direction="BULLISH_SWEEP",
                            level_price=target_level.price,
                            level_type=target_level.level_type,
                            extreme_price=float(bar_s["Low"]),
                        )
                        break
                if sweep is not None:
                    break

            if sweep is None:
                return False, "NO_SWEEP", {}

            prior_highs = [fh for fh in fractal_highs if fh.confirmed_time < sweep.timestamp]
            if not prior_highs:
                return False, "NO_STRUCTURAL_HIGH_PRIOR_SWEEP", {}

            struct_high = prior_highs[-1].price
            mss: Optional[MSSEvent] = None
            for m_idx in get_inclusive_bar_range(sweep.bar_index + 1, BT_CFG.MAX_SWEEP_TO_MSS_BARS, n):
                if df_closed["Close"].iloc[m_idx] > struct_high:
                    mss = MSSEvent(
                        timestamp=df_closed.index[m_idx],
                        bar_index=m_idx,
                        struct_level=struct_high,
                        break_price=float(df_closed["Close"].iloc[m_idx]),
                    )
                    break

            if mss is None:
                return False, "MSS_TIMEOUT", {}

            displacement: Optional[DisplacementEvent] = None
            for d_idx in get_inclusive_bar_range(mss.bar_index + 1, BT_CFG.MAX_MSS_TO_DISP_BARS, n):
                b = df_closed.iloc[d_idx]
                disp_atr = float(df_closed["ATR"].iloc[d_idx])
                b_rng = max(float(b["High"] - b["Low"]), 1e-5)
                b_body = abs(float(b["Close"] - b["Open"]))
                b_ratio = b_body / b_rng
                rng_atr_ratio = b_rng / max(disp_atr, 1e-5)

                if (b_ratio >= min_disp_ratio) and (rng_atr_ratio >= 0.85):
                    displacement = DisplacementEvent(
                        timestamp=df_closed.index[d_idx],
                        bar_index=d_idx,
                        body_ratio=b_ratio,
                        range_atr_ratio=rng_atr_ratio,
                    )
                    break

            if displacement is None:
                return False, "NO_DISPLACEMENT", {}

            fvg: Optional[FVGStructure] = None
            start_fvg_center = displacement.bar_index + 2
            for f_idx in get_inclusive_bar_range(start_fvg_center, BT_CFG.MAX_DISP_TO_FVG_BARS, n - 1):
                c1 = df_closed.iloc[f_idx - 1]
                c3 = df_closed.iloc[f_idx + 1]
                fvg_atr = float(df_closed["ATR"].iloc[f_idx + 1])
                if c1["High"] < c3["Low"]:
                    gap_bot = float(c1["High"])
                    gap_top = float(c3["Low"])
                    gap_size = gap_top - gap_bot
                    if gap_size >= (0.20 * fvg_atr):
                        fvg = FVGStructure(
                            created_time=df_closed.index[f_idx],
                            confirmed_time=df_closed.index[f_idx + 1],
                            bar_index=f_idx + 1,
                            direction="BULLISH",
                            top=gap_top,
                            bottom=gap_bot,
                            size=gap_size,
                        )
                        break

            if fvg is None:
                return False, "NO_FVG", {}

            if (t_now_idx - fvg.bar_index) > BT_CFG.MAX_FVG_TO_RETEST_BARS:
                return False, "FVG_STALE_TIMEOUT", {}

            penetrated = (cur_bar["Low"] <= fvg.top) and (cur_bar["Low"] >= (fvg.bottom - 0.25 * cur_atr))
            closed_above = cur_bar["Close"] >= fvg.bottom
            lower_wick = min(float(cur_bar["Open"]), float(cur_bar["Close"])) - float(cur_bar["Low"])
            bar_span = max(float(cur_bar["High"] - cur_bar["Low"]), 1e-5)
            rejection_wick = (lower_wick / bar_span) >= min_wick_ratio

            if not (penetrated and closed_above and rejection_wick):
                return False, "FVG_RETEST_INCOMPLETE_OR_WEAK_REJECTION", {}

            sl_price = sweep.extreme_price - (sl_atr_buf * cur_atr)
            setup_id = f"BUY|{sweep.timestamp.isoformat()}|{fvg.confirmed_time.isoformat()}"

            return True, "VALID_BULLISH_SEQUENCE", {
                "direction": "BUY",
                "setup_id": setup_id,
                "sl_price": round(sl_price, 2),
            }

        else:
            candidate_highs: List[CausalLevel] = [lv for lv in levels if lv.level_type == "PDH"]
            candidate_highs += eqh
            candidate_highs += fractal_highs

            sweep = None
            for s_idx in range(t_now_idx - 5, max(0, t_now_idx - 18), -1):
                bar_s = df_closed.iloc[s_idx]
                bar_s_time = df_closed.index[s_idx]
                for target_level in candidate_highs:
                    if target_level.confirmed_time < bar_s_time and bar_s["High"] > target_level.price and bar_s["Close"] < target_level.price:
                        sweep = SweepEvent(
                            timestamp=bar_s_time,
                            bar_index=s_idx,
                            direction="BEARISH_SWEEP",
                            level_price=target_level.price,
                            level_type=target_level.level_type,
                            extreme_price=float(bar_s["High"]),
                        )
                        break
                if sweep is not None:
                    break

            if sweep is None:
                return False, "NO_SWEEP", {}

            prior_lows = [fl for fl in fractal_lows if fl.confirmed_time < sweep.timestamp]
            if not prior_lows:
                return False, "NO_STRUCTURAL_LOW_PRIOR_SWEEP", {}

            struct_low = prior_lows[-1].price
            mss = None
            for m_idx in get_inclusive_bar_range(sweep.bar_index + 1, BT_CFG.MAX_SWEEP_TO_MSS_BARS, n):
                if df_closed["Close"].iloc[m_idx] < struct_low:
                    mss = MSSEvent(
                        timestamp=df_closed.index[m_idx],
                        bar_index=m_idx,
                        struct_level=struct_low,
                        break_price=float(df_closed["Close"].iloc[m_idx]),
                    )
                    break

            if mss is None:
                return False, "MSS_TIMEOUT", {}

            displacement = None
            for d_idx in get_inclusive_bar_range(mss.bar_index + 1, BT_CFG.MAX_MSS_TO_DISP_BARS, n):
                b = df_closed.iloc[d_idx]
                disp_atr = float(df_closed["ATR"].iloc[d_idx])
                b_rng = max(float(b["High"] - b["Low"]), 1e-5)
                b_body = abs(float(b["Close"] - b["Open"]))
                b_ratio = b_body / b_rng
                rng_atr_ratio = b_rng / max(disp_atr, 1e-5)

                if (b_ratio >= min_disp_ratio) and (rng_atr_ratio >= 0.85):
                    displacement = DisplacementEvent(
                        timestamp=df_closed.index[d_idx],
                        bar_index=d_idx,
                        body_ratio=b_ratio,
                        range_atr_ratio=rng_atr_ratio,
                    )
                    break

            if displacement is None:
                return False, "NO_DISPLACEMENT", {}

            fvg = None
            start_fvg_center = displacement.bar_index + 2
            for f_idx in get_inclusive_bar_range(start_fvg_center, BT_CFG.MAX_DISP_TO_FVG_BARS, n - 1):
                c1 = df_closed.iloc[f_idx - 1]
                c3 = df_closed.iloc[f_idx + 1]
                fvg_atr = float(df_closed["ATR"].iloc[f_idx + 1])
                if c1["Low"] > c3["High"]:
                    gap_top = float(c1["Low"])
                    gap_bot = float(c3["High"])
                    gap_size = gap_top - gap_bot
                    if gap_size >= (0.20 * fvg_atr):
                        fvg = FVGStructure(
                            created_time=df_closed.index[f_idx],
                            confirmed_time=df_closed.index[f_idx + 1],
                            bar_index=f_idx + 1,
                            direction="BEARISH",
                            top=gap_top,
                            bottom=gap_bot,
                            size=gap_size,
                        )
                        break

            if fvg is None:
                return False, "NO_FVG", {}

            if (t_now_idx - fvg.bar_index) > BT_CFG.MAX_FVG_TO_RETEST_BARS:
                return False, "FVG_STALE_TIMEOUT", {}

            penetrated = (cur_bar["High"] >= fvg.bottom) and (cur_bar["High"] <= (fvg.top + 0.25 * cur_atr))
            closed_below = cur_bar["Close"] <= fvg.top
            upper_wick = float(cur_bar["High"]) - max(float(cur_bar["Open"]), float(cur_bar["Close"]))
            bar_span = max(float(cur_bar["High"] - cur_bar["Low"]), 1e-5)
            rejection_wick = (upper_wick / bar_span) >= min_wick_ratio

            if not (penetrated and closed_below and rejection_wick):
                return False, "FVG_RETEST_INCOMPLETE_OR_WEAK_REJECTION", {}

            sl_price = sweep.extreme_price + (sl_atr_buf * cur_atr)
            setup_id = f"SELL|{sweep.timestamp.isoformat()}|{fvg.confirmed_time.isoformat()}"

            return True, "VALID_BEARISH_SEQUENCE", {
                "direction": "SELL",
                "setup_id": setup_id,
                "sl_price": round(sl_price, 2),
            }


