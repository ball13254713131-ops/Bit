class PerformanceTracker:
    DEFAULT = {
        "wins": 0, "losses": 0, "total": 0, "win_rate": 0.0,
        "total_points": 0.0, "total_pips": 0.0,
        "best_trade_points": 0.0, "worst_trade_points": 0.0,
        "buy_signals": 0, "sell_signals": 0,
        "started_at": None, "last_updated": None, "history": [],
    }

    def __init__(self, path: str = None):
        self.path = path or CFG.STATS_FILE
        self.data = self._load()

    def _load(self) -> dict:
        try:
            if os.path.exists(self.path):
                with open(self.path, "r", encoding="utf-8") as f:
                    d = json.load(f)
                for k, v in self.DEFAULT.items():
                    d.setdefault(k, v)
                return d
        except Exception as e:
            log.warning(f"[Stats] อ่านไฟล์สถิติไม่สำเร็จ: {e}")
        d = dict(self.DEFAULT)
        d["started_at"] = fmt_th(now_th())
        return d

    def save(self) -> None:
        with FILE_LOCK:
            try:
                self.data["last_updated"] = fmt_th(now_th())
                with open(self.path, "w", encoding="utf-8") as f:
                    json.dump(self.data, f, ensure_ascii=False, indent=2)
            except Exception as e:
                log.error(f"[Stats] บันทึกไฟล์ไม่สำเร็จ: {e}")

    def record_signal(self, direction: str) -> None:
        if direction == "BUY":
            self.data["buy_signals"] += 1
        elif direction == "SELL":
            self.data["sell_signals"] += 1
        self.save()

    def record_result(self, trade: dict, result: str, points: float) -> None:
        if result == "TP":
            self.data["wins"] += 1
        else:
            self.data["losses"] += 1
        self.data["total"] += 1
        self.data["total_points"] += points
        self.data["total_pips"] += points / 10.0
        self.data["best_trade_points"] = max(self.data["best_trade_points"], points)
        self.data["worst_trade_points"] = min(self.data["worst_trade_points"], points)
        self.data["win_rate"] = round(
            (self.data["wins"] / self.data["total"]) * 100, 2
        ) if self.data["total"] else 0.0

        self.data["history"].append({
            "id": trade.get("id"),
            "direction": trade.get("direction"),
            "entry": trade.get("entry"),
            "exit": trade.get("take_profit") if result == "TP" else trade.get("stop_loss"),
            "result": result,
            "points": round(points, 1),
            "pips": round(points / 10.0, 1),
            "closed_at": fmt_th(now_th()),
        })
        self.data["history"] = self.data["history"][-100:]
        self.save()

    def summary(self) -> str:
        d = self.data
        return (f"✅ ชนะ: **{d['wins']}** | ❌ แพ้: **{d['losses']}** | รวม: **{d['total']}** ไม้\n"
                f"🎯 Win Rate: **{d['win_rate']}%** | กำไรสะสม: **{d['total_points']:+.1f} pts**")


