# SECTION 5.1 : FALLBACK QUANT ENGINE
# ==========================================================================================
class FallbackEngine:
    @staticmethod
    def decide(ctx: dict, reason: str = "") -> dict:
        direction = ctx.get("direction", "NONE")
        if direction not in ("BUY", "SELL"):
            return {"decision": "WAIT", "source": "FallbackQuant",
                    "reasoning_th": "ไม่มีทิศทางที่ผ่านเกณฑ์ Confluence"}

        entry = ctx["price"]
        atr = max(ctx["ltf_atr"], 0.5)
        buffer = CFG.SL_ATR_BUFFER * atr

        if direction == "BUY":
            struct = ctx["sweep"].get("swept_level") or ctx["sweep"].get("ref_low") or (entry - 2 * atr)
            fvg_bot = ctx["fvg"].get("bottom")
            if fvg_bot:
                struct = min(struct, fvg_bot)
            sl = struct - buffer
            risk = entry - sl
            if risk <= 0:
                sl = entry - (2.0 * atr)
                risk = entry - sl
            tp = entry + (risk * CFG.MIN_RR)
        else:
            struct = ctx["sweep"].get("swept_level") or ctx["sweep"].get("ref_high") or (entry + 2 * atr)
            fvg_top = ctx["fvg"].get("top")
            if fvg_top:
                struct = max(struct, fvg_top)
            sl = struct + buffer
            risk = sl - entry
            if risk <= 0:
                sl = entry + (2.0 * atr)
                risk = sl - entry
            tp = entry - (risk * CFG.MIN_RR)

        rr = abs(tp - entry) / max(abs(entry - sl), 1e-9)

        return {
            "decision": direction,
            "source": "FallbackQuant",
            "entry": round(entry, 2),
            "stop_loss": round(sl, 2),
            "take_profit": round(tp, 2),
            "risk_reward": round(rr, 2),
            "confidence": 65,
            "liquidity_narrative": ctx["sweep"]["detail"],
            "structure_reason": f"SL วางนอกโครงสร้าง Swing ที่ {struct:.2f} เผื่อ {CFG.SL_ATR_BUFFER}×ATR",
            "reasoning_th": f"[โหมดสำรอง] {reason} — คำนวณด้วย Quant SMC Rule (R:R 1:{rr:.2f})",
            "invalidation": f"แท่ง M15 ปิด{'ต่ำกว่า' if direction=='BUY' else 'สูงกว่า'} {sl:.2f}",
        }


