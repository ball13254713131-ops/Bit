# SECTION 2 : TIME & VOLATILITY FILTER (GOLD KILLZONES)
# ==========================================================================================
class KillzoneFilter:
    @staticmethod
    def _in_range(t: datetime, start: tuple, end: tuple) -> bool:
        cur = t.hour * 60 + t.minute
        s = start[0] * 60 + start[1]
        e = end[0] * 60 + end[1]
        return s <= cur <= e

    @classmethod
    def check(cls, t: datetime = None) -> dict:
        t = t or now_th()
        if t.weekday() not in CFG.TRADE_WEEKDAYS:
            return {"active": False, "zone": "WEEKEND",
                    "reason": "ตลาดทองคำปิดทำการช่วงเสาร์-อาทิตย์"}

        for kz in CFG.KILLZONES:
            if cls._in_range(t, kz["start"], kz["end"]):
                return {"active": True, "zone": kz["name"],
                        "reason": f"อยู่ในช่วง {kz['name']} "
                                  f"({kz['start'][0]:02d}:{kz['start'][1]:02d}-"
                                  f"{kz['end'][0]:02d}:{kz['end'][1]:02d} น.)"}

        return {"active": False, "zone": "WAIT_OUTSIDE_KILLZONE",
                "reason": f"เวลา {t.strftime('%H:%M')} น. อยู่นอก Killzone "
                          f"(London 14:00-17:30 / NY 19:30-23:30) — งดเปิดออเดอร์ใหม่"}

    @classmethod
    def next_killzone_str(cls, t: datetime = None) -> str:
        t = t or now_th()
        cands = []
        for day_offset in range(0, 4):
            d = t + timedelta(days=day_offset)
            if d.weekday() not in CFG.TRADE_WEEKDAYS:
                continue
            for kz in CFG.KILLZONES:
                start = d.replace(hour=kz["start"][0], minute=kz["start"][1], second=0, microsecond=0)
                if start > t:
                    cands.append((start, kz["name"]))
        if not cands:
            return "ไม่ทราบ"
        cands.sort(key=lambda x: x[0])
        nxt, name = cands[0]
        delta = nxt - t
        hrs = int(delta.total_seconds() // 3600)
        mins = int((delta.total_seconds() % 3600) // 60)
        return f"{name} เวลา {nxt.strftime('%d/%m %H:%M')} น. (อีก {hrs} ชม. {mins} นาที)"


