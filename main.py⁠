class GoldSMCBot:
    def __init__(self):
        self.feed = MarketDataFeed()
        self.news = NewsBlackoutEngine()
        self.ai = AIBrain()
        self.stats = PerformanceTracker()
        self.notifier = DiscordNotifier()
        self.trades = TradeManager(self.notifier, self.stats)
        self.scan_count = 0
        self.last_heartbeat = time.time()

    def scan_once(self) -> None:
        self.scan_count += 1
        BOT_STATE["scan_count"] = self.scan_count
        BOT_STATE["last_scan"] = fmt_th(now_th())
        BOT_STATE["active_trades"] = len(self.trades.trades)

        live = self.feed.get_live_price()
        if live > 0:
            BOT_STATE["last_price"] = live
            self.trades.monitor(live)

        kz = KillzoneFilter.check()
        BOT_STATE["killzone"] = kz["zone"]
        if not kz["active"]:
            BOT_STATE["status"] = "WAIT_OUTSIDE_KILLZONE"
            log.info(f"[Scan #{self.scan_count}] ⏸️ {kz['reason']}")
            return

        bo = self.news.check_blackout()
        if bo["blackout"]:
            BOT_STATE["status"] = "NEWS_BLACKOUT"
            log.info(f"[Scan #{self.scan_count}] 📰 {bo['reason']}")
            return

        ok, why = self.trades.can_open()
        if not ok:
            BOT_STATE["status"] = "COOLDOWN"
            log.info(f"[Scan #{self.scan_count}] 🔒 {why}")
            return

        BOT_STATE["status"] = "SCANNING"
        htf = self.feed.get_htf()
        ltf = self.feed.get_ltf()
        if htf.empty or ltf.empty:
            log.warning(f"[Scan #{self.scan_count}] ข้อมูลราคาไม่ครบ ข้ามรอบนี้")
            return

        ctx = SMCEngine.evaluate(htf, ltf)
        BOT_STATE["last_price"] = ctx["price"]

        log.info(
            f"[Scan #{self.scan_count}] 💰 {ctx['price']:.2f} | KZ={kz['zone']} | "
            f"H1={ctx['htf_bias']} | Zone={ctx['pd_array']['zone']} "
            f"({ctx['pd_array']['position_pct']:.0f}%) | RSI={ctx['ltf_rsi']:.1f} | "
            f"Sweep(B/S)={ctx['sweep']['bullish_sweep']}/{ctx['sweep']['bearish_sweep']} | "
            f"FVG={ctx['fvg']['type']}"
        )

        if ctx["direction"] == "NONE":
            log.info(f"   ↳ ยังไม่ครบเกณฑ์ (ฝั่ง {ctx.get('best_side','-')} "
                     f"ผ่าน {ctx.get('best_score','-')}) ขาด: {', '.join(ctx['reject_reasons'])}")
            BOT_STATE["status"] = "NO_SETUP"
            return

        log.info(f"   ↳ ✅ พบ Confluence ฝั่ง {ctx['direction']} → ส่ง AI ตรวจสอบ")
        news_next = self.news.next_event()
        decision = self.ai.validate(ctx, kz, news_next)

        if decision.get("decision") not in ("BUY", "SELL"):
            log.info(f"   ↳ 🧠 AI สั่ง WAIT: {decision.get('reasoning_th', '-')}")
            BOT_STATE["status"] = "AI_WAIT"
            return

        self.trades.open_trade(decision, ctx, kz, news_next)
        BOT_STATE["status"] = "SIGNAL_SENT"
        BOT_STATE["active_trades"] = len(self.trades.trades)

    def maybe_heartbeat(self) -> None:
        if (time.time() - self.last_heartbeat) >= CFG.HEARTBEAT_HOURS * 3600:
            try:
                self.notifier.send_heartbeat(
                    self.stats, BOT_STATE["last_price"],
                    KillzoneFilter.check(), self.trades.trades
                )
                self.last_heartbeat = time.time()
            except Exception as e:
                log.warning(f"[Heartbeat] ส่งไม่สำเร็จ: {e}")

    def run(self) -> None:
        log.info("=" * 70)
        log.info("  INSTITUTIONAL SPOT GOLD (XAUUSD) SMC BOT STARTING...")
        log.info("=" * 70)
        BOT_STATE["status"] = "running"
        self.news.fetch(force=True)
        self.notifier.send_startup(self.stats)

        while True:
            cycle_start = time.time()
            try:
                self.scan_once()
                self.maybe_heartbeat()
            except KeyboardInterrupt:
                break
            except Exception as e:
                log.error(f"[Main] เกิดข้อผิดพลาด: {e}")
                log.error(traceback.format_exc())
                time.sleep(30)

            elapsed = time.time() - cycle_start
            time.sleep(max(CFG.SCAN_INTERVAL_SEC - elapsed, 10))


def main():
    start_web_server()
    time.sleep(1)
    bot = GoldSMCBot()
    bot.run()


if __name__ == "__main__":
    main()
