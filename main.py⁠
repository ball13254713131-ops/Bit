def calculate_technical_indicators(df):
    """คำนวณ EMA 20, 50, 200, RSI 14 และ ATR 14"""
    df["EMA_20"] = df["Close"].ewm(span=20, adjust=False).mean()
    df["EMA_50"] = df["Close"].ewm(span=50, adjust=False).mean()
    df["EMA_200"] = df["Close"].ewm(span=200, adjust=False).mean()

    delta = df["Close"].diff()
    gain = (delta.where(delta > 0, 0)).rolling(14).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(14).mean()
    rs = gain / loss
    df["RSI"] = 100 - (100 / (1 + rs))

    df["H-L"] = df["High"] - df["Low"]
    df["H-PC"] = (df["High"] - df["Close"].shift(1)).abs()
    df["L-PC"] = (df["Low"] - df["Close"].shift(1)).abs()
    df["TR"] = df[["H-L", "H-PC", "L-PC"]].max(axis=1)
    df["ATR"] = df["TR"].rolling(14).mean()
    return df

def analyze_market_conditions(df):
    """ระบบตรวจจับ Confluence (EMA + RSI + SMC FVG)"""
    if len(df) < 205:
        return None

    df = calculate_technical_indicators(df)

    curr = df.iloc[-1]
    b3 = df.iloc[-2]
    b2 = df.iloc[-3]
    b1 = df.iloc[-4]

    current_price = float(curr["Close"])
    ema20 = float(curr["EMA_20"])
    ema50 = float(curr["EMA_50"])
    ema200 = float(curr["EMA_200"])
    rsi = float(curr["RSI"]) if not pd.isna(curr["RSI"]) else 50.0
    atr = float(curr["ATR"]) if not pd.isna(curr["ATR"]) else 3.5

    bullish_factors = []
    bearish_factors = []

    if current_price > ema200:
        bullish_factors.append("ราคาอยู่เหนือ EMA 200 (Bullish Major Trend)")
    else:
        bearish_factors.append("ราคาอยู่ใต้ EMA 200 (Bearish Major Trend)")

    if ema20 > ema50:
        bullish_factors.append("EMA 20 ตัดขึ้นเหนือ EMA 50 (Golden Cross)")
    elif ema20 < ema50:
        bearish_factors.append("EMA 20 ตัดลงใต้ EMA 50 (Death Cross)")

    if 45 <= rsi <= 68:
        bullish_factors.append(f"RSI โมเมนตัมขาขึ้นชัดเจน ({rsi:.1f})")
    elif 32 <= rsi <= 55:
        bearish_factors.append(f"RSI โมเมนตัมขาลงชัดเจน ({rsi:.1f})")

    fvg_type = "None"
    fvg_top = 0.0
    fvg_bottom = 0.0

    if b1["High"] < b3["Low"]:
        fvg_top = float(b3["Low"])
        fvg_bottom = float(b1["High"])
        if curr["Low"] <= fvg_top and current_price >= fvg_bottom:
            bullish_factors.append(f"SMC: รีเทสต์โซน Demand FVG ({fvg_bottom:.2f} - {fvg_top:.2f})")
            fvg_type = "Bullish FVG Retest"

    elif b1["Low"] > b3["High"]:
        fvg_top = float(b1["Low"])
        fvg_bottom = float(b3["High"])
        if curr["High"] >= fvg_bottom and current_price <= fvg_top:
            bearish_factors.append(f"SMC: เด้งทดสอบโซน Supply FVG ({fvg_bottom:.2f} - {fvg_top:.2f})")
            fvg_type = "Bearish FVG Retest"

    if len(bullish_factors) >= 3 and current_price > ema200:
        signal = "BUY"
        factors = bullish_factors
    elif len(bearish_factors) >= 3 and current_price < ema200:
        signal = "SELL"
        factors = bearish_factors
    else:
        return None

    return {
        "signal": signal,
        "fvg_type": fvg_type,
        "fvg_top": round(fvg_top, 2),
        "fvg_bottom": round(fvg_bottom, 2),
        "current_price": round(current_price, 2),
        "ema20": round(ema20, 2),
        "ema50": round(ema50, 2),
        "ema200": round(ema200, 2),
        "rsi": round(rsi, 2),
        "atr": round(atr, 2),
        "factors": factors,
        "recent_high": round(float(df["High"].iloc[-12:].max()), 2),
        "recent_low": round(float(df["Low"].iloc[-12:].min()), 2)
    }

def gemini_advanced_validation(setup):
    """ส่งข้อมูลคอนฟลูเอนซ์ให้ Gemini วิเคราะห์และกำหนด SL/TP (พร้อมระบบสำรองอัตโนมัติ)"""
    entry = setup["current_price"]
    sl_buffer = setup["atr"] * 1.5
    fallback_sl = (entry - sl_buffer) if setup["signal"] == "BUY" else (entry + sl_buffer)
    fallback_tp = (entry + (sl_buffer * CONFIG["MIN_RR_RATIO"])) if setup["signal"] == "BUY" else (entry - (sl_buffer * CONFIG["MIN_RR_RATIO"]))

    fallback_decision = {
        "action": setup["signal"],
        "entry": entry,
        "sl": round(fallback_sl, 2),
        "tp": round(fallback_tp, 2),
        "confidence": "Quant Rule-based",
        "reason": "โครงสร้างราคาและ Indicator สอดคล้องตามกลยุทธ์ SMC + Confluence"
    }

    if not ai_client:
        return fallback_decision

    prompt = f"""
    คุณเป็นนักวิเคราะห์ระบบเทรดทองคำ Spot Gold (XAUUSD) ที่เชี่ยวชาญ SMC, Price Action และ Multi-Indicator Confluence
    ตรวจพบสัญญาณ:
    - สัญญาณหลัก: {setup['signal']}
    - ราคา Spot ล่าสุด: {setup['current_price']} | โซน FVG: {setup['fvg_type']} ({setup['fvg_bottom']} - {setup['fvg_top']})
    - EMA 20/50/200: {setup['ema20']} / {setup['ema50']} / {setup['ema200']}
    - RSI: {setup['rsi']} | ATR: {setup['atr']}
    - สวิงราคาสุด: High {setup['recent_high']} / Low {setup['recent_low']}
    - ปัจจัยยืนยัน: {", ".join(setup['factors'])}

    เงื่อนไข:
    1. ตรวจสอบว่าสัญญาณสอดคล้องกับภาพรวมเทรนด์ ไม่ติด Fakeout
    2. ตั้ง SL นอกแนวสำคัญ และ TP อัตราส่วน R:R ไม่ต่ำกว่า 1:2
    3. หากก้ำกึ่งให้ตอบ WAIT

    ตอบเป็น JSON เท่านั้น:
    {{
        "action": "{setup['signal']}" หรือ "WAIT",
        "entry": {setup['current_price']},
        "sl": 0.0,
        "tp": 0.0,
        "confidence": "90%",
        "reason": "สรุปเหตุผลกระชับ คมชัด สไตล์นักเทรดมืออาชีพ"
    }}
    """

    models_to_try = ["gemini-2.5-flash", "gemini-1.5-flash"]
    
    for m in models_to_try:
        try:
            response = ai_client.models.generate_content(
                model=m,
                contents=prompt
            )
            clean_text = response.text.strip()
            if clean_text.startswith("```json"):
                clean_text = clean_text[7:]
            if clean_text.endswith("```"):
                clean_text = clean_text[:-3]
            return json.loads(clean_text.strip())
        except Exception as e:
            logging.warning(f"เรียกใช้โมเดล {m} ไม่สำเร็จ: {e}")
            continue

    logging.info("สลับมาใช้ระบบคำนวณ Quant SL/TP อัตโนมัติ")
    return fallback_decision

def check_active_trade(current_price):
    global active_order, performance_stats
    if not active_order:
        return

    side = active_order["action"]
    entry = active_order["entry"]
    tp = active_order["tp"]
    sl = active_order["sl"]
    outcome = None
    pnl = 0.0

    if side == "BUY":
        if current_price >= tp:
            outcome = "WIN"
            pnl = round(current_price - entry, 2)
        elif current_price <= sl:
            outcome = "LOSS"
            pnl = round(current_price - entry, 2)
    elif side == "SELL":
        if current_price <= tp:
            outcome = "WIN"
            pnl = round(entry - current_price, 2)
        elif current_price >= sl:
            outcome = "LOSS"
            pnl = round(entry - current_price, 2)

    if outcome:
        performance_stats["total"] += 1
        if outcome == "WIN":
            performance_stats["wins"] += 1
        else:
            performance_stats["losses"] += 1

        save_performance_stats(performance_stats)

        win_rate = (performance_stats["wins"] / performance_stats["total"]) * 100
        
        is_win = (outcome == "WIN")
        embed_color = 0x00FFA3 if is_win else 0xFF2A6D
        status_banner = "🎯 [TRADE TARGET HIT // PROFIT LOCKED]" if is_win else "🛑 [STOP LOSS TRIGGERED // RISK MITIGATED]"
        pnl_sign = "+" if pnl > 0 else ""
        
        embed = {
            "title": status_banner,
            "description": f"```diff\n{'+' if is_win else '-'} RESULT: {outcome} ({side} ORDER)\n{'+' if is_win else '-'} PnL: {pnl_sign}{pnl:.2f} PTS ({pnl_sign}{int(pnl*10)} PIPS)\n```",
            "color": embed_color,
            "fields": [
                {
                    "name": "📌 รายละเอียดราคา (Spot Gold)",
                    "value": f"• จุดเข้า: `{entry:.2f}`\n• จุดปิด: `{current_price:.2f}`",
                    "inline": True
                },
                {
                    "name": "🏆 ผลงานสะสม",
                    "value": f"• ชนะ: `{performance_stats['wins']}` ไม้\n• แพ้: `{performance_stats['losses']}` ไม้",
                    "inline": True
                },
                {
                    "name": "📈 WIN RATE สะสม",
                    "value": f"```ansi\n\u001b[1;32m{win_rate:.1f}%\u001b[0m (จากทั้งหมด {performance_stats['total']} ไม้)\n```",
                    "inline": False
                }
            ],
            "footer": {
                "text": "QUANT ALPHA ENGINE • SPOT GOLD REAL-TIME",
                "icon_url": "https://cdn-icons-png.flaticon.com/512/1006/1006771.png"
            },
            "timestamp": datetime.now(pytz.utc).isoformat()
        }
        send_discord_message(embed)
        active_order = None

def run_bot_cycle():
    global active_order
    try:
        check_and_send_thai_forex_news()

        df = yf.download(CONFIG["SYMBOL"], period=CONFIG["HISTORY_PERIOD"], interval=CONFIG["INTERVAL"], progress=False)
        if df.empty:
            logging.info("รอข้อมูลแท่งเทียน Spot Gold...")
            return

        if isinstance(df.columns, pd.MultiIndex):
            df.columns = [col[0] for col in df.columns]

        current_price = float(df["Close"].iloc[-1])
        logging.info(f"เช็กราคาทองคำ Spot ล่าสุด: {current_price:.2f}")

        # ส่งสัญญาณ Heartbeat ทุก 3 ชม. แจ้งเตือนว่าบอทยังเฝ้ากราฟอยู่
        send_heartbeat_status(current_price)

        if active_order:
            check_active_trade(current_price)
            return

        setup = analyze_market_conditions(df)
        if not setup:
            logging.info("ยังไม่พบสัญญาณที่เข้าเงื่อนไข Confluence")
            return

        decision = gemini_advanced_validation(setup)
        if not decision or decision.get("action") == "WAIT":
            logging.info("Gemini แนะนำให้รอจังหวะที่ชัดเจนกว่านี้ (WAIT)")
